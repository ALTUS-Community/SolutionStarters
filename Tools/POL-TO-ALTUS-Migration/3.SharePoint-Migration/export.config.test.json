          "entityAttribute": "statuscode",
          "type": "Status",
          "choiceMap": {
            "(1) Active": 1,
            "(2) Postponed": 955000000,
            "(3) Closed": 955000001
          }
        },
        {
          "spFieldInternalName": "Category",
          "entityAttribute": "sensei_category",
          "type": "OptionSet",
          "choiceMap": {
            "Resource": 955000000,
            "Scope": 955000001,
            "Schedule": 955000002,
            "Technology": 955000003,
            "Business Process": 955000004,
            "Vendor": 955000005,
            "Management Escalation": 955000006,
            "Other": 955000007,
            "(1) Category1": 955000007,
            "(2) Category2": 955000007,
            "(3) Category3": 955000007
          }
        },

        {
          "spFieldInternalName": "Priority",
          "entityAttribute": "sensei_priority",
