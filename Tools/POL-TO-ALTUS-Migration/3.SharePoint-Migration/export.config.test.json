            "(2) Category2": 955000007,
            "(3) Category3": 955000007
          }
        },

        {
          "spFieldInternalName": "Probability",
          "entityAttribute": "sensei_likelihood",
          "type": "OptionSet",
          "thresholds": {
            "0": 955000000,
            "0.2": 955000001,
            "0.4": 955000002,
            "0.6": 955000003,
            "0.8": 955000004
          }
        },
        {
          "spFieldInternalName": "Impact",
          "entityAttribute": "sensei_consequence",
          "type": "OptionSet",
          "thresholds": {
            "0": 955000000,
            "1": 955000000,
            "3": 955000001,
            "5": 955000002,
            "7": 955000003,
            "9": 955000004
          }
        },

        {
          "spFieldInternalName": "Exposure",
          "entityAttribute": "sensei_riskscore",
          "type": "Number"
        },
        {
          "spFieldInternalName": "Cost",
          "entityAttribute": "sensei_cost",
