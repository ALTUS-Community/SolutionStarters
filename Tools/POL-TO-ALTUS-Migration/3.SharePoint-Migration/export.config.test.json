          "entityAttribute": "sensei_mitigationplan",
          "type": "Text"
        },
        {
          "spFieldInternalName": "Contingency_x0020_plan",
          "entityAttribute": "sensei_contingencyplan",
          "type": "Text"
        },
        {
          "spFieldInternalName": "Trigger_x0020_Description",
          "entityAttribute": "sensei_triggerdescription",
          "type": "Text"
        },

        {
          "spFieldInternalName": "Trigger",
          "entityAttribute": "sensei_trigger",
          "type": "OptionSet",
          "choiceMap": {
            "Date": 955000000,
            "Exposure over threshold": 955000001,
            "Tasks not completed": 955000002,
            "Other": 955000003
